POSTGRES_DB=yomuyomu
POSTGRES_USER=yomuyomu
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
AI_PROMPT_VERSION=v2
AI_CACHE_TTL_SECONDS=86400

# Use :80 for first deploy by VM IP. Change to your domain after DNS points to the VM.
YOMUYOMU_SITE_ADDRESS=:80
WEB_ORIGIN=http://YOUR_VM_EXTERNAL_IP

# Keep these relative so Caddy proxies browser calls through the same origin.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_NLP_BASE_URL=/nlp

# Set false after a real JMDict sqlite has been generated at services/nlp/data/jmdict.sqlite.
ALLOW_SEED_FALLBACK=true
